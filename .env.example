# Copia a .env.local; nunca subas valores reales.
DATABASE_URL=postgresql://usuario:clave@host/db?sslmode=require
ANTHROPIC_API_KEY=
# Opcional: modelo de la IA (por defecto claude-sonnet-5-5).
ANTHROPIC_MODEL=
# Opcional: tope de propuestas de la IA por persona en 24 h (por defecto 30).
AI_DAILY_LIMIT=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
TEST_DATABASE_URL=
# Solo local: entrada con contraseña para usuarios prueba.* (se ignora en producción).
ENABLE_TEST_LOGIN=
TEST_LOGIN_PASSWORD=
